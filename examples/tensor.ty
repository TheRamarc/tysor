# ── modelconfig ─
config modelconfig:
  vocab_size   : int32   = 32000
  hidden_dim   : int32   = 4096
  n_layers     : int32   = 32
  n_heads      : int32   = 32
  n_kv_heads   : int32   = 8
  intermediate : int32   = 11008
  max_seq_len  : int32   = 4096
  rope_theta   : float32 = 10000.0
  dropout      : float32 = 0.0
  head_dim     : int32 = 8
  epochs       : int32 = 36

# ── Layers ──

layer RMsNorm(x: tensor): tensor:
  return x -> rms_norm(modelconfig.hidden_dim)

layer RotaryEmbedding(x: tensor): tensor: 
  return x -> rope(modelconfig.max_seq_len, modelconfig.rope_theta)

layer GroupedQueryAttention(x: tensor): tensor:
   q_proj = linear(modelconfig.hidden_dim, modelconfig.hidden_dim)
   k_proj = linear(modelconfig.hidden_dim, modelconfig.n_kv_heads * modelconfig.head_dim)
   v_proj = linear(modelconfig.hidden_dim, modelconfig.n_kv_heads * modelconfig.head_dim)
   o_proj = linear(modelconfig.hidden_dim, modelconfig.hidden_dim)

   q = x -> q_proj() -> reshape(heads: modelconfig.n_heads) -> RotaryEmbedding()
   k = x -> k_proj() -> reshape(heads: modelconfig.n_kv_heads) -> RotaryEmbedding()
   v = x -> v_proj() -> reshape(heads: modelconfig.n_kv_heads)
   k = k -> repeat_kv(modelconfig.n_heads / modelconfig.n_kv_heads)
   v = v -> repeat_kv(modelconfig.n_heads / modelconfig.n_kv_heads)

  # attn = Dropout(Softmax(causal_mask(scale(q * k))))

   attn = q * k -> scale( modelconfig.n_heads) -> causal_mask() -> Softmax() -> Dropout(modelconfig.dropout)

   return attn * v -> flatten_heads() -> o_proj()

layer SwiGLU(x: tensor): tensor:
   gate_proj = linear(modelconfig.hidden_dim, modelconfig.intermediate)
   up_proj   = linear(modelconfig.hidden_dim, modelconfig.intermediate)
   down_proj = linear(modelconfig.intermediate, modelconfig.hidden_dim)

   gate = x -> gate_proj() -> SiLU()
   up   = x -> up_proj()

   return gate * up -> down_proj()

layer DecoderBlock(x: tensor): tensor:
   x = x + (x -> RMSNorm() -> GroupedQueryAttention())
   return x + (x -> RMSNorm() -> SwiGLU())

# ── Model ───────

layer model(idx, targets=true): (tensor, tensor):
  # logits = linear(RMSNorm(DecoderBlock(Dropout(Embedding(idx))))) here DecoderBlock * modelconfig.n_layers is basically
  # that DecoderBlock how DecoderBlock block the computation go through.
   logits = idx -> Embedding(modelconfig.vocab_size, modelconfig.hidden_dim)
               -> Dropout(modelconfig.dropout)
               -> DecoderBlock()[modelconfig.n_layers] 
               -> RMSNorm()
               -> linear(modelconfig.hidden_dim, modelconfig.vocab_size)
   loss = cross_entropy(logits, targets)
   return logits, loss
